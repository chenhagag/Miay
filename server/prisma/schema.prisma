generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Household {
  id          String   @id @default(uuid())
  name        String
  numChildren Int      @default(0)
  createdAt   DateTime @default(now())
  users       User[]
  tasks       Task[]
}

model User {
  id           String   @id @default(uuid())
  householdId  String
  name         String
  email        String   @unique
  passwordHash String
  avatarColor  String   @default("#6366f1")
  createdAt    DateTime @default(now())
  household    Household @relation(fields: [householdId], references: [id])
  assignedTasks Task[]  @relation("AssignedTasks")
  createdTasks  Task[]  @relation("CreatedTasks")
  completions   TaskCompletion[]
}

enum TaskType {
  RECURRING
  ONE_TIME
  UNSCHEDULED
}

enum Recurrence {
  DAILY
  WEEKLY
  MONTHLY
}

model Task {
  id             String    @id @default(uuid())
  householdId    String
  title          String
  description    String?
  assigneeId     String?
  createdById    String?
  type           TaskType  @default(UNSCHEDULED)
  recurrence     Recurrence?
  recurrenceDays Int[]     @default([])
  scheduledDate  DateTime?
  timeSpecific   Boolean   @default(false)
  startTime      String?
  endTime        String?
  weight         Int       @default(2)
  category       String    @default("general")
  isPreloaded    Boolean   @default(false)
  isCompleted    Boolean   @default(false)
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  household   Household @relation(fields: [householdId], references: [id])
  assignee    User?     @relation("AssignedTasks", fields: [assigneeId], references: [id])
  createdBy   User?     @relation("CreatedTasks", fields: [createdById], references: [id])
  completions TaskCompletion[]
}

model TaskCompletion {
  id            String   @id @default(uuid())
  taskId        String
  completedById String
  completedDate DateTime @default(now())
  createdAt     DateTime @default(now())

  task        Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  completedBy User @relation(fields: [completedById], references: [id])

  @@unique([taskId, completedById, completedDate])
}
